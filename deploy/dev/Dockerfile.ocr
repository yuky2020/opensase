# OCR service for the Edge's DLP (ADR-0024). Builds with the classic builder too.
FROM golang:1.27-alpine AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-trimpath
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -ldflags="-s -w" -o /out/ocrd ./cmd/ocrd

FROM alpine:3.22
RUN apk add --no-cache tesseract-ocr tesseract-ocr-data-eng tesseract-ocr-data-ita
COPY --from=build /out/ocrd /usr/local/bin/ocrd
USER 65534:65534
EXPOSE 8090
ENTRYPOINT ["/usr/local/bin/ocrd"]
