[Unit]
Description=OpenSASE Client Desktop Daemon
Documentation=https://github.com/yuky2020/opensase
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/opensased
Restart=on-failure
RuntimeDirectory=opensase
StateDirectory=opensase
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/opensase /run/opensase

[Install]
WantedBy=multi-user.target
