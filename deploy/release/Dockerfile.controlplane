ARG VERSION=dev

FROM golang:1.27-alpine AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-trimpath
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -ldflags="-s -w" -o /out/controlplane ./cmd/controlplane && \
    go build -ldflags="-s -w" -o /out/opensasectl ./cmd/opensasectl

FROM gcr.io/distroless/static-debian12:nonroot
ARG VERSION
LABEL org.opencontainers.image.source="https://github.com/yuky2020/opensase" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.title="OpenSASE Control Plane" \
      org.opencontainers.image.description="OpenSASE Control Plane: multi-tenant administration, PKI, policy snapshots, and admin portal"
COPY --from=build /out/controlplane /controlplane
COPY --from=build /out/opensasectl /opensasectl
COPY clients/admin/build/web /portal
ENV OPENSASE_PORTAL_DIR=/portal
USER 65532:65532
EXPOSE 9443/tcp
ENTRYPOINT ["/controlplane"]
