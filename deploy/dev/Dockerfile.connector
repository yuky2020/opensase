# Builds with the classic builder too (no BuildKit-only syntax).
FROM golang:1.27-alpine AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-trimpath
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -ldflags="-s -w" -o /out/connector ./cmd/connector && \
    mkdir -p /out/state && chmod 0700 /out/state

# Non-root (uid 65532). Outbound only: no port is exposed.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/connector /connector
COPY --from=build --chown=65532:65532 /out/state /var/lib/opensase-connector
USER 65532:65532
ENTRYPOINT ["/connector"]
