# Builds with the classic builder too (no BuildKit-only syntax).
FROM golang:1.27-alpine AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-trimpath
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -ldflags="-s -w" -o /out/opensase-client ./cmd/opensase-client

FROM alpine:3.22
RUN apk add --no-cache iproute2 iptables ca-certificates curl bind-tools netcat-openbsd
COPY --from=build /out/opensase-client /usr/local/bin/opensase-client
COPY deploy/dev/client-entrypoint.sh /usr/local/bin/client-entrypoint.sh
RUN chmod 0755 /usr/local/bin/client-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/client-entrypoint.sh"]
