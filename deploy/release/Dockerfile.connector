ARG VERSION=dev

FROM golang:1.27-alpine AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-trimpath
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -ldflags="-s -w" -o /out/connector ./cmd/connector && \
    mkdir -p /out/state && chmod 0700 /out/state

FROM gcr.io/distroless/static-debian12:nonroot
ARG VERSION
LABEL org.opencontainers.image.source="https://github.com/yuky2020/opensase" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.title="OpenSASE Connector" \
      org.opencontainers.image.description="OpenSASE Connector: outbound-only private application connector"
COPY --from=build /out/connector /connector
COPY --from=build --chown=65532:65532 /out/state /var/lib/opensase-connector
USER 65532:65532
ENTRYPOINT ["/connector"]
