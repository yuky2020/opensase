ARG VERSION=dev

FROM golang:1.27-alpine AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-trimpath
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -ldflags="-s -w" -o /out/ocrd ./cmd/ocrd

FROM alpine:3.22
ARG VERSION
LABEL org.opencontainers.image.source="https://github.com/yuky2020/opensase" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.title="OpenSASE OCR" \
      org.opencontainers.image.description="OpenSASE OCR service for data loss prevention"
RUN apk add --no-cache tesseract-ocr tesseract-ocr-data-eng tesseract-ocr-data-ita
COPY --from=build /out/ocrd /usr/local/bin/ocrd
USER 65534:65534
EXPOSE 8090
ENTRYPOINT ["/usr/local/bin/ocrd"]
